{
  "info": {
    "name": "Blog API - EmbarkX",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "After calling 'Create Post', copy the returned 'id' (UUID) and set it as the collection variable 'postId' to use in Get/Delete requests."
  },
  "variable": [
    {
      "key": "postId",
      "value": "",
      "description": "UUID of a created post. Paste from the 'Create Post' response."
    }
  ],
  "item": [
    {
      "name": "Create Post",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts?title=My First Post&content=This is the content of my first post",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts"],
          "query": [
            { "key": "title", "value": "My First Post" },
            { "key": "content", "value": "This is the content of my first post" }
          ],
          "protocol": "http"
        },
        "description": "Returns the created Post object with id (UUID), title, content, and createdAt."
      }
    },
    {
      "name": "Create Post - Empty Title",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts?title=&content=Content with no title",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts"],
          "query": [
            { "key": "title", "value": "" },
            { "key": "content", "value": "Content with no title" }
          ],
          "protocol": "http"
        },
        "description": "Creates a post with an empty title (no title validation is enforced)."
      }
    },
    {
      "name": "Get All Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts"],
          "protocol": "http"
        },
        "description": "Returns a JSON array of Post objects."
      }
    },
    {
      "name": "Get Post By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/{{postId}}",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "{{postId}}"],
          "protocol": "http"
        },
        "description": "Fetches a single Post by UUID. Set the 'postId' collection variable to a valid UUID from Create Post."
      }
    },
    {
      "name": "Get Post By ID - Not Found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/00000000-0000-0000-0000-000000000000",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "00000000-0000-0000-0000-000000000000"],
          "protocol": "http"
        },
        "description": "Returns 404 when the UUID does not match any stored post."
      }
    },
    {
      "name": "Validate Content - OK",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/validate?content=Short content",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "validate"],
          "query": [{ "key": "content", "value": "Short content" }],
          "protocol": "http"
        }
      }
    },
    {
      "name": "Validate Content - Too Long",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/validate?",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "validate"],
          "query": [
            {
              "key": "content",
              "value": ""
            }
          ],
          "protocol": "http"
        },
        "description": "Returns 'Too long' when content exceeds 5000 characters."
      }
    },
    {
      "name": "Delete Post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/{{postId}}",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "{{postId}}"],
          "protocol": "http"
        },
        "description": "Deletes the post with the given UUID. Set the 'postId' collection variable first."
      }
    },
    {
      "name": "Delete Post - Not Found",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/00000000-0000-0000-0000-000000000000",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "00000000-0000-0000-0000-000000000000"],
          "protocol": "http"
        },
        "description": "Returns 404 when the UUID does not match any stored post."
      }
    },
    {
      "name": "Get Total Word Count",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/posts/total",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "total"],
          "protocol": "http"
        },
        "description": "Returns the sum of word counts across all stored post content."
      }
    }
  ]
}
